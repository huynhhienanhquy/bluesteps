e":"Hành động của người dân hôm nay không chỉ là làm sạch môi trường. Đó là biểu tượng cho sự hồi sinh, cho hy vọng và ý chí không bao giờ đầu hàng số phận. Họ đang cùng nhau xây dựng lại cuộc sống từ chính nơi cơn bão đã tàn phá. Đây chính là hình ảnh đẹp nhất về sức sống kiên cường của người Việt Nam trước thiên tai.","type":"TEXT","parent":"386:17941","x":24,"y":934,"width":291,"height":90,"text":"Hành động của người dân hôm nay không chỉ là làm sạch môi trường. Đó là biểu tượng cho sự hồi sinh, cho hy vọng và ý chí không bao giờ đầu hàng số phận. Họ đang cùng nhau xây dựng lại cuộc sống từ chính nơi cơn bão đã tàn phá. Đây chính là hình ảnh đẹp nhất về sức sống kiên cường của người Việt Nam trước thiên tai.","opacity":1},{"id":"386:17943","name":"4. Xây dựng lại từ đống đổ nát","type":"TEXT","parent":"386:17941","x":12,"y":915,"width":145,"height":12,"text":"4. Xây dựng lại từ đống đổ nát","opacity":1},{"id":"386:17944","name":"ô nhiểm","type":"GROUP","parent":"386:17940","x":12,"y":753,"width":381,"height":198,"opacity":1},{"id":"386:17945","name":"image","type":"GROUP","parent":"386:17944","x":243,"y":753,"width":150,"height":198,"opacity":1},{"id":"386:17946","name":"Rectangle 977","type":"RECTANGLE","parent":"386:17945","x":243,"y":798,"width":70,"height":90,"opacity":1},{"id":"386:17947","name":"Rectangle 979","type":"RECTANGLE","parent":"386:17945","x":323,"y":861,"width":70,"height":90,"opacity":1},{"id":"386:17948","name":"Rectangle 978","type":"RECTANGLE","parent":"386:17945","x":323,"y":753,"width":70,"height":90,"opacity":1},{"id":"386:17949","name":"3.\"Giải cứu\" bãi biển khỏi thảm họa rác thải","type":"TEXT","parent":"386:17944","x":12,"y":767,"width":310,"height":18,"text":"3.\"Giải cứu\" bãi biển khỏi thảm họa rác thải","opacity":1},{"id":"386:17950","name":"Lượng rác mà cơn bão số 13 mang vào bờ là khổng lồ, bao gồm đủ loại: rác thải nhựa, lưới đánh cá hỏng, mảnh vỡ từ các công trình và vô số rác sinh hoạt. Ngăn chặn ô nhiễm thứ cấp: Việc dọn dẹp ngay lập tức giúp ngăn chặn rác thải tiếp tục phân rã, ngấm vào cát và nước biển, gây ra thảm họa môi trường kéo dài.","type":"TEXT","parent":"386:17944","x":24,"y":788,"width":219,"height":126,"text":"Lượng rác mà cơn bão số 13 mang vào bờ là khổng lồ, bao gồm đủ loại: rác thải nhựa, lưới đánh cá hỏng, mảnh vỡ từ các công trình và vô số rác sinh hoạt.\nNgăn chặn ô nhiễm thứ cấp: Việc dọn dẹp ngay lập tức giúp ngăn chặn rác thải tiếp tục phân rã, ngấm vào cát và nước biển, gây ra thảm họa môi trường kéo dài.\n","opacity":1},{"id":"386:17951","name":"Group 37150","type":"GROUP","parent":"386:17904","x":12,"y":1010,"width":386,"height":50,"opacity":1},{"id":"386:17952","name":"Rectangle 1111","type":"RECTANGLE","parent":"386:17951","x":12,"y":1010,"width":386,"height":50,"opacity":1},{"id":"386:17953","name":"Group 36735","type":"GROUP","parent":"386:17887","x":-4,"y":810,"width":444,"height":116,"opacity":1},{"id":"386:17954","name":"Group 36733","type":"GROUP","parent":"386:17953","x":-4,"y":849,"width":185,"height":77,"opacity":1},{"id":"386:17955","name":"Rectangle 17","type":"RECTANGLE","parent":"386:17954","x":-4,"y":849,"width":185,"height":77,"opacity":1},{"id":"386:17956","name":"Rectangle 18","type":"RECTANGLE","parent":"386:17953","x":255,"y":851,"width":185,"height":75,"opacity":1},{"id":"386:17957","name":"Rectangle 87","type":"VECTOR","parent":"386:17953","x":173,"y":859,"width":95,"height":67,"opacity":1},{"id":"386:17958","name":"Group 36734","type":"GROUP","parent":"386:17953","x":285,"y":868,"width":112,"height":28,"opacity":1},{"id":"386:17959","name":"Group 36722","type":"GROUP","parent":"386:17958","x":369,"y":868,"width":28,"height":28,"opacity":1},{"id":"386:17960","name":"Group","type":"GROUP","parent":"386:17959","x":369,"y":868,"width":28,"height":28,"opacity":1},{"id":"386:17961","name":"Vector","type":"VECTOR","parent":"386:17960","x":377.400390625,"y":873.60009765625,"width":11.200000762939453,"height":11.19999885559082,"opacity":1},{"id