47","type":"GROUP","name":"Group 3","x":46.2080078125,"y":570.3587646484375,"width":19.58333396911621,"height":13.855076789855957,"opacity":1,"render":{"x":46.2080078125,"y":570.3587646484375,"w":19.58333396911621,"h":13.8551025390625}},{"id":"I386:9747;2278:511","parent":"I386:9747;2278:510","type":"VECTOR","name":"Vector","x":46.2080078125,"y":570.3587646484375,"width":19.58333396911621,"height":13.855076789855957,"opacity":1,"render":{"x":46.2080078125,"y":570.3587646484375,"w":19.5830078125,"h":13.8551025390625},"radius":0},{"id":"386:9748","parent":"386:9722","type":"RECTANGLE","name":"image 29","x":292,"y":566,"width":25,"height":25,"opacity":1,"render":{"x":292,"y":566,"w":25,"h":25},"radius":0},{"id":"386:9749","parent":"386:9711","type":"GROUP","name":"introduction","x":29,"y":634,"width":389,"height":174,"opacity":1,"render":{"x":29,"y":634,"w":389,"h":174}},{"id":"386:9750","parent":"386:9749","type":"TEXT","name":"Hôm nay, các bạn nhỏ đã có một buổi học thực hành vô cùng ý nghĩa: trải nghiệm tự tay phân loại rác thải. Thay vì chỉ học qua tranh ảnh, các bé đã trực tiếp \"biến\" rác thành những tài nguyên có ích bằng cách bỏ rác vào đúng các thùng quy định: \"Rác Hữu Cơ\", \"Rác Vô Cơ\" và \"Rác Tái Chế\". Hoạt động thực hành này không chỉ giúp các em nhận biết và ghi nhớ các loại rác, mà quan trọng hơn là xây dựng ý thức bảo vệ môi trường ngay từ những năm tháng đầu đời. Nhìn những bàn tay nhỏ bé cẩn thận, hào hứng tham gia, chúng ta tin rằng một thế hệ \"chiến binh xanh\" đang lớn lên!","x":29,"y":658,"width":370,"height":150,"opacity":1,"render":{"x":29.375,"y":659.8579711914062,"w":366.6591796875,"h":147.73291015625},"text":"Hôm nay, các bạn nhỏ đã có một buổi học thực hành vô cùng ý nghĩa: trải nghiệm tự tay phân loại rác thải.\nThay vì chỉ học qua tranh ảnh, các bé đã trực tiếp \"biến\" rác thành những tài nguyên có ích bằng cách bỏ rác vào đúng các thùng quy định: \"Rác Hữu Cơ\", \"Rác Vô Cơ\" và \"Rác Tái Chế\".\nHoạt động thực hành này không chỉ giúp các em nhận biết và ghi nhớ các loại rác, mà quan trọng hơn là xây dựng ý thức bảo vệ môi trường ngay từ những năm tháng đầu đời. Nhìn những bàn tay nhỏ bé cẩn thận, hào hứng tham gia, chúng ta tin rằng một thế hệ \"chiến binh xanh\" đang lớn lên!","fontSize":12,"fontName":{"family":"Inter","style":"Regular","variationSettings":{"wght":400,"slnt":0}},"lineHeight":{"unit":"AUTO"}},{"id":"386:9751","parent":"386:9749","type":"TEXT","name":"Chung Tay Thực Hành Phân Loại Rác Vì Trái Đất Xanh","x":29,"y":634,"width":389,"height":18,"opacity":1,"render":{"x":29.7568359375,"y":635.98828125,"w":387.064453125,"h":15.2503662109375},"text":"Chung Tay Thực Hành Phân Loại Rác Vì Trái Đất Xanh","fontSize":15,"fontName":{"family":"Inter","style":"Bold","variationSettings":{"wght":700,"slnt":0}},"lineHeight":{"unit":"AUTO"}},{"id":"386:9752","parent":"386:9711","type":"GROUP","name":"hoạt động khác","x":22,"y":840,"width":465,"height":235,"opacity":1,"render":{"x":22,"y":840,"w":406,"h":45}},{"id":"386:9753","parent":"386:9752","type":"TEXT","name":"Hoạt động khác","x":22,"y":840,"width":154,"height":24,"opacity":1,"render":{"x":23.2646484375,"y":843.453125,"w":151.365234375,"h":19.86505126953125},"text":"Hoạt động khác","fontSize":20,"fontName":{"family":"Inter","style":"Bold","variationSettings":{"wght":700,"slnt":0}},"lineHeight":{"unit":"AUTO"}},{"id":"386:9754","parent":"386:9752","type":"TEXT","name":"Tất cả","x":370,"y":844,"width":46,"height":15,"opacity":1,"render":{"x":370.4970703125,"y":846.5056762695312,"w":40.158203125,"h":11.64349365234375},"text":"Tất cả","fontSize":14,"fontName":{"family":"Inter","style":"Bold","variationSettings":{"wght":700,"slnt":0}},"lineHeight":{"unit":"AUTO"}},{"id":"386:9755","parent":"386:9752","type":"GROUP","name":"works","x":23,"y":874,"width":464,"height":201,"opacity":1,"render":{"x":22,"y":874,"w":406,"h":11}},{"id":"386:9756","parent":"386:9755","type":"INSTANCE","name":"work","x":331,"y":874,"width":156,"height":201,"opacity":1,"