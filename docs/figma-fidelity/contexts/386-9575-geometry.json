ế\".\nHoạt động thực hành này không chỉ giúp các em nhận biết và ghi nhớ các loại rác, mà quan trọng hơn là xây dựng ý thức bảo vệ môi trường ngay từ những năm tháng đầu đời. Nhìn những bàn tay nhỏ bé cẩn thận, hào hứng tham gia, chúng ta tin rằng một thế hệ \"chiến binh xanh\" đang lớn lên!","fontSize":12,"fontName":{"family":"Inter","style":"Regular","variationSettings":{"wght":400,"slnt":0}},"lineHeight":{"unit":"AUTO"}},{"id":"386:9645","parent":"386:9643","type":"TEXT","name":"Chung Tay Thực Hành Phân Loại Rác Vì Trái Đất Xanh","x":29,"y":634,"width":389,"height":18,"opacity":1,"render":{"x":29.75634765625,"y":635.98828125,"w":387.06494140625,"h":15.2503662109375},"text":"Chung Tay Thực Hành Phân Loại Rác Vì Trái Đất Xanh","fontSize":15,"fontName":{"family":"Inter","style":"Bold","variationSettings":{"wght":700,"slnt":0}},"lineHeight":{"unit":"AUTO"}},{"id":"386:9646","parent":"386:9605","type":"GROUP","name":"hoạt động khác","x":22,"y":840,"width":465,"height":235,"opacity":1,"render":{"x":22,"y":840,"w":406,"h":34}},{"id":"386:9647","parent":"386:9646","type":"TEXT","name":"Hoạt động khác","x":22,"y":840,"width":154,"height":24,"opacity":1,"render":{"x":23.26416015625,"y":843.453125,"w":151.365234375,"h":19.86505126953125},"text":"Hoạt động khác","fontSize":20,"fontName":{"family":"Inter","style":"Bold","variationSettings":{"wght":700,"slnt":0}},"lineHeight":{"unit":"AUTO"}},{"id":"386:9648","parent":"386:9646","type":"TEXT","name":"Tất cả","x":370,"y":844,"width":46,"height":15,"opacity":1,"render":{"x":370.4970703125,"y":846.5056762695312,"w":40.158203125,"h":11.64349365234375},"text":"Tất cả","fontSize":14,"fontName":{"family":"Inter","style":"Bold","variationSettings":{"wght":700,"slnt":0}},"lineHeight":{"unit":"AUTO"}},{"id":"386:9649","parent":"386:9646","type":"GROUP","name":"works","x":23,"y":874,"width":464,"height":201,"opacity":1,"render":{"x":22,"y":874,"w":406,"h":0}},{"id":"386:9650","parent":"386:9649","type":"INSTANCE","name":"work","x":331,"y