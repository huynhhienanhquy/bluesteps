        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "x-error-codes": {
          "401": [
            "AUTH_REQUIRED",
            "SESSION_REVOKED"
          ],
          "404": [
            "SCAN_NOT_FOUND",
            "ITEM_NOT_FOUND"
          ],
          "409": [
            "SCAN_NOT_READY",
            "SOURCE_ALREADY_RECORDED",
            "IDEMPOTENCY_CONFLICT"
          ],
          "422": [
            "VALIDATION_ERROR"
          ],
          "429": [
            "RATE_LIMITED"
          ],
          "503": [
            "SERVICE_UNAVAILABLE"
          ]
        },
        "x-business-gate": {
          "decisionId": "DEC05",
          "recordActionWithoutAward": true,
          "awardUntilApprovedPolicy": "not_awarded / 0 / POLICY_NOT_ENABLED"
        }
      }
    },
