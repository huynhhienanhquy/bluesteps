  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "field",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Liveness": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "ScanSortingRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "const": "scan"
          },
          "scanId": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "source",
          "scanId",
          "itemId"
        ]
      },
      "ManualSortingRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "const": "manual"
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "source",
          "itemId"
        ]
      },
      "SortingRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ScanSortingRequest"
          },
          {
            "$ref": "#/components/schemas/ManualSortingRequest"
          }
        ],
        "discriminator": {
          "propertyName": "source",
          "mapping": {
            "scan": "#/components/schemas/ScanSortingRequest",
            "manual": "#/components/schemas/ManualSortingRequest"
          }
        }
      },
      "NoAward": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "not_awarded"
          },
          "points": {
            "type": "string",
            "const": "0"
          },
          "ruleVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "POLICY_NOT_ENABLED",
              "SOURCE_INELIGIBLE",
              "LIMIT_REACHED"
            ]
          }
        },
        "required": [
          "status",
          "points",
          "ruleVersion",
          "reason"
        ]
      },
      "PendingAward": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "pending_review"
          },
          "points": {
            "type": "string",
            "const": "0"
          },
          "ruleVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "const": "PENDING_REVIEW"
          }
        },
        "required": [
          "status",
          "points",
          "ruleVersion",
          "reason"
        ]
      },
      "GrantedAward": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "awarded"
          },
          "points": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "ruleVersion": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "const": "AWARDED"
          }
        },
        "required": [
          "status",
          "points",
          "ruleVersion",
          "reason"
        ]
      },
      "SortingAward": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/NoAward"
          },
          {
            "$ref": "#/components/schemas/PendingAward"
          },
          {
            "$ref": "#/components/schemas/GrantedAward"
          }
        ]
      },
      "SortingResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionId": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "evidenceStatus": {
            "type": "string",
            "enum": [
              "user_confirmed",
              "self_reported"
            ]
          },
          "award": {
            "$ref": "#/components/schemas/SortingAward"
          },
          "walletBalance": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "required": [
          "actionId",
          "itemId",
          "evidenceStatus",
          "award"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "deviceLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 1024
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenPair": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "refreshToken": {
            "type": "string",
            "minLength": 1
          },
          "tokenType": {
            "type": "string",
