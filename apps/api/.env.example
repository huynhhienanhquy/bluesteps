BLUESTEPS_ENVIRONMENT=development
# Runtime login must inherit bluesteps_runtime; never use the migration owner here.
BLUESTEPS_DATABASE_URL=postgresql+psycopg://RUNTIME_LOGIN:PASSWORD@127.0.0.1:54322/bluesteps
BLUESTEPS_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@127.0.0.1:54322/bluesteps
# Generate real keys with: python -m bluesteps_api.cli init-local-env
BLUESTEPS_JWT_PRIVATE_KEY=''
BLUESTEPS_JWT_PUBLIC_KEY=''
BLUESTEPS_JWT_KEY_ID=''
BLUESTEPS_OTP_PEPPER=''
BLUESTEPS_CORS_ORIGINS='["http://localhost:8081","http://127.0.0.1:8081","http://localhost:4173","http://127.0.0.1:4173"]'
BLUESTEPS_REGISTRATION_ENABLED=false
# Empty directory uses EfficientNetB0_FastKAN_Export at the repository root.
BLUESTEPS_SCAN_MODEL_DIRECTORY=''
BLUESTEPS_SCAN_CONFIDENCE_THRESHOLD=0.6
# Keyless routing. Development defaults to the public Valhalla demo; test/production
# require an explicit URL. Review the provider's fair-use policy before publishing.
# https://valhalla.github.io/valhalla/start/introduction/
BLUESTEPS_ROUTING_URL=https://valhalla1.openstreetmap.de
BLUESTEPS_ROUTING_CLIENT_ID=bluesteps-local-development
BLUESTEPS_ROUTING_TIMEOUT_S=12
# The client map uses OpenFreeMap Liberty; no map API key is required.
# For explicit development-only email delivery: .local/mail
BLUESTEPS_LOCAL_MAIL_DIRECTORY=''
# Alternatively configure SMTP with mandatory STARTTLS.
BLUESTEPS_SMTP_HOST=''
BLUESTEPS_SMTP_PORT=587
BLUESTEPS_SMTP_USERNAME=''
BLUESTEPS_SMTP_PASSWORD=''
BLUESTEPS_MAIL_FROM=''
