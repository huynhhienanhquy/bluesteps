{
  "name": "@bluesteps/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "go": "expo start --go --lan",
    "go:tunnel": "expo start --go --tunnel",
    "go:link": "node scripts/serve-go-link.cjs",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform web",
    "build:map-vendor": "node scripts/build-map-vendor.cjs",
    "typecheck": "node scripts/generate-route-types.cjs && tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:dev-proxy": "node --test scripts/dev-api-proxy.test.cjs",
    "test:e2e": "playwright test",
    "check:native-config": "node scripts/verify-native-config.cjs",
    "preview": "node scripts/serve-preview.cjs",
    "format": "prettier --write app src e2e scripts *.js *.ts *.json ../../packages/design-tokens/src",
    "format:check": "prettier --check app src e2e scripts *.js *.ts *.json ../../packages/design-tokens/src",
    "check:live-data": "node scripts/check-live-data.cjs",
    "test:e2e:live": "playwright test live-backend.spec.ts"
  },
  "dependencies": {
    "@bluesteps/api-client": "workspace:*",
    "@bluesteps/design-tokens": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/mulish": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~58.0.21",
    "expo-audio": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-video": "~58.0.13",
    "maplibre-gl": "^5.24.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.65.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  }
}
